rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admit-chem@chemcat.app';
    }
    function isTeacher() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }
    match /chemicals/{id} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
    match /teachers/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow write: if isAdmin();
    }
  }
}
